# Copy to .env
ANTHROPIC_API_KEY=
# REGISTRY=mirror.gcr.io

# Model routing: cheap model classifies, strong model reasons and calls tools
CHEAP_MODEL=claude-haiku-5-5
STRONG_MODEL=claude-opus-5-5
STRONG_EFFORT=medium

# Retrieval: local ONNX models (no data leaves the machine). RERANKER=cohere needs COHERE_API_KEY.
EMBEDDER=fastembed
RERANKER=fastembed
# COHERE_API_KEY=

# Langfuse tracing (cloud or self-hosted). Leave empty to disable.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

BRIDGE_CLIENT_ID=ops-copilot
BRIDGE_CLIENT_SECRET=ops-copilot-demo-secret
BUSINESS_DATE=2026-10-27
