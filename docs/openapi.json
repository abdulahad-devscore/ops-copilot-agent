{
    "openapi": "3.1.0",
    "info": {
        "title": "Ops Copilot Agent",
        "description": "LangGraph operations agent over company documents and the ERP MCP Bridge.",
        "version": "1.0.0"
    },
    "paths": {
        "/healthz": {
            "get": {
                "tags": [
                    "ops"
                ],
                "summary": "Healthz",
                "operationId": "healthz_healthz_get",
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {}
                            }
                        }
                    }
                }
            }
        },
        "/v1/chat": {
            "post": {
                "tags": [
                    "chat"
                ],
                "summary": "Chat",
                "operationId": "chat_v1_chat_post",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/ChatRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/RunResult"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/v1/runs": {
            "get": {
                "tags": [
                    "runs"
                ],
                "summary": "Runs",
                "operationId": "runs_v1_runs_get",
                "parameters": [
                    {
                        "name": "limit",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "default": 50,
                            "title": "Limit"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {}
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/v1/runs/{thread_id}": {
            "get": {
                "tags": [
                    "runs"
                ],
                "summary": "Run",
                "operationId": "run_v1_runs__thread_id__get",
                "parameters": [
                    {
                        "name": "thread_id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "title": "Thread Id"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/RunResult"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/v1/runs/{thread_id}/resume": {
            "post": {
                "tags": [
                    "runs"
                ],
                "summary": "Resume",
                "description": "Re-check the bridge and continue. Safe to call any time; a still-pending action just pauses again.",
                "operationId": "resume_v1_runs__thread_id__resume_post",
                "parameters": [
                    {
                        "name": "thread_id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "title": "Thread Id"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/RunResult"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/v1/bridge-callback/{thread_id}": {
            "post": {
                "tags": [
                    "runs"
                ],
                "summary": "Bridge Callback",
                "operationId": "bridge_callback_v1_bridge_callback__thread_id__post",
                "parameters": [
                    {
                        "name": "thread_id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "title": "Thread Id"
                        }
                    },
                    {
                        "name": "user-agent",
                        "in": "header",
                        "required": false,
                        "schema": {
                            "anyOf": [
                                {
                                    "type": "string"
                                },
                                {
                                    "type": "null"
                                }
                            ],
                            "title": "User-Agent"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "additionalProperties": true,
                                "title": "Body"
                            }
                        }
                    }
                },
                "responses": {
                    "202": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {}
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "ChatRequest": {
                "properties": {
                    "question": {
                        "type": "string",
                        "maxLength": 4000,
                        "minLength": 2,
                        "title": "Question"
                    },
                    "user": {
                        "$ref": "#/components/schemas/User"
                    },
                    "thread_id": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Thread Id"
                    }
                },
                "type": "object",
                "required": [
                    "question",
                    "user"
                ],
                "title": "ChatRequest"
            },
            "HTTPValidationError": {
                "properties": {
                    "detail": {
                        "items": {
                            "$ref": "#/components/schemas/ValidationError"
                        },
                        "type": "array",
                        "title": "Detail"
                    }
                },
                "type": "object",
                "title": "HTTPValidationError"
            },
            "RunResult": {
                "properties": {
                    "thread_id": {
                        "type": "string",
                        "title": "Thread Id"
                    },
                    "status": {
                        "type": "string",
                        "title": "Status"
                    },
                    "route": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Route"
                    },
                    "answer": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Answer"
                    },
                    "citations": {
                        "items": {
                            "additionalProperties": true,
                            "type": "object"
                        },
                        "type": "array",
                        "title": "Citations",
                        "default": []
                    },
                    "action": {
                        "anyOf": [
                            {
                                "additionalProperties": true,
                                "type": "object"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Action"
                    },
                    "tools_called": {
                        "items": {
                            "type": "string"
                        },
                        "type": "array",
                        "title": "Tools Called",
                        "default": []
                    },
                    "tool_log": {
                        "items": {
                            "additionalProperties": true,
                            "type": "object"
                        },
                        "type": "array",
                        "title": "Tool Log",
                        "default": []
                    },
                    "cost_usd": {
                        "type": "number",
                        "title": "Cost Usd",
                        "default": 0.0
                    },
                    "cost_by_model": {
                        "additionalProperties": {
                            "type": "number"
                        },
                        "type": "object",
                        "title": "Cost By Model",
                        "default": {}
                    },
                    "input_tokens": {
                        "type": "integer",
                        "title": "Input Tokens",
                        "default": 0
                    },
                    "output_tokens": {
                        "type": "integer",
                        "title": "Output Tokens",
                        "default": 0
                    },
                    "latency_ms": {
                        "type": "integer",
                        "title": "Latency Ms",
                        "default": 0
                    },
                    "trace_url": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Trace Url"
                    }
                },
                "type": "object",
                "required": [
                    "thread_id",
                    "status"
                ],
                "title": "RunResult"
            },
            "User": {
                "properties": {
                    "id": {
                        "type": "string",
                        "title": "Id"
                    },
                    "role": {
                        "type": "string",
                        "title": "Role",
                        "default": "staff"
                    },
                    "erp_token": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Erp Token"
                    }
                },
                "type": "object",
                "required": [
                    "id"
                ],
                "title": "User"
            },
            "ValidationError": {
                "properties": {
                    "loc": {
                        "items": {
                            "anyOf": [
                                {
                                    "type": "string"
                                },
                                {
                                    "type": "integer"
                                }
                            ]
                        },
                        "type": "array",
                        "title": "Location"
                    },
                    "msg": {
                        "type": "string",
                        "title": "Message"
                    },
                    "type": {
                        "type": "string",
                        "title": "Error Type"
                    },
                    "input": {
                        "title": "Input"
                    },
                    "ctx": {
                        "type": "object",
                        "title": "Context"
                    }
                },
                "type": "object",
                "required": [
                    "loc",
                    "msg",
                    "type"
                ],
                "title": "ValidationError"
            }
        }
    }
}
